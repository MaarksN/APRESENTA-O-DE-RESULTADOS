{
  "name": "apresenta-o-de-resultados",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "lint:js": "eslint \"**/*.mjs\"",
    "lint:css": "stylelint \"*.html\"",
    "lint:html": "html-validate \"*.html\"",
    "format": "prettier --write \"*.{html,json,mjs}\" \"data/**/*.json\" \"schemas/**/*.json\"",
    "format:check": "prettier --check \"*.{html,json,mjs}\" \"data/**/*.json\" \"schemas/**/*.json\"",
    "validate:data": "node scripts/validate-kpis.mjs",
    "test": "npm run validate:data && playwright test",
    "test:a11y": "playwright test --grep accessibility",
    "quality:lighthouse": "lhci autorun",
    "export:pdf": "node scripts/export-pdf.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaarksN/APRESENTA-O-DE-RESULTADOS.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/MaarksN/APRESENTA-O-DE-RESULTADOS/issues"
  },
  "homepage": "https://github.com/MaarksN/APRESENTA-O-DE-RESULTADOS#readme",
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "chart.js": "^4.5.1",
    "countup.js": "^2.10.1",
    "driver.js": "^1.8.0",
    "html2pdf.js": "^0.14.0",
    "lucide": "^1.30.0",
    "mermaid": "^11.16.1",
    "reveal.js": "^6.0.1",
    "rough-notation": "^0.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "decktape": "^3.16.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "html-validate": "^11.6.2",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "vite": "^8.2.1"
  },
  "allowScripts": {
    "core-js@3.50.0": true,
    "puppeteer@24.40.0": true
  }
}
